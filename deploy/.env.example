# Copy to deploy/.env and replace every typed slot before internet exposure.
DOMAIN=DOMAIN
ALLOWED_ORIGIN=https://DOMAIN
OWNER_USERNAME=owner
APP_IMAGE=network-atlas:local
SESSION_HOURS=12
LOGIN_LIMIT_PER_MINUTE=5
WRITE_LIMIT_PER_MINUTE=120
MONITOR_MAX_CONCURRENCY=1
MONITOR_TICK_SECONDS=5
MONITOR_COMPACTOR_TICK_SECONDS=3600
MONITOR_COMPACTOR_PARTITIONS_PER_TICK=32
# Destructive cleanup is opt-in. Keep false until backup/restore and capacity are verified.
MONITOR_RETENTION_ENABLED=false
MONITOR_RETENTION_DELETE_BATCH_SIZE=5000
MONITOR_RAW_OBSERVED_RETENTION_DAYS=7
MONITOR_RAW_NON_OBSERVED_RETENTION_DAYS=30
MONITOR_HOUR_RETENTION_DAYS=90
MONITOR_DAY_RETENTION_DAYS=365
RUST_LOG=network_atlas=info
